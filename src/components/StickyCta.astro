---
// Barre « Réserver 30 minutes » fixée en bas de l'écran, sur mobile et tablette (proposition 3).
// Apparaît quand le bouton du hero est sorti de l'écran par le haut ; s'efface dès que la section
// contact (bouton et formulaire) ou le pied de page arrive à l'écran, pour ne jamais les recouvrir.
// Au-dessus de 1100 px, l'en-tête garde son propre bouton : pas de barre. Sans JavaScript : pas de barre.
import { getContent, type Locale } from "../i18n";
import CalendlyLink from "./CalendlyLink.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<div
  class="sticky-cta"
  data-sticky-cta
  data-anchor=".hero__cta"
  data-stop={`#${t.ui.anchors.contact}, .site-footer`}
  aria-hidden="true"
  inert
>
  <CalendlyLink class="sticky-cta__button" locale={locale} position="sticky" size="block">
    {t.ui.bookCall}
  </CalendlyLink>
</div>

<script>
  import { initStickyCta } from "../scripts/sticky-cta";
  initStickyCta();
</script>

<style>
  .sticky-cta {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 15;
    padding: 12px 16px max(20px, env(safe-area-inset-bottom));
    background: rgb(10 10 8 / 0.94);
    border-top: 1px solid var(--line-visible);
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform 0.3s var(--ease),
      visibility 0s linear 0.3s;
  }

  .sticky-cta.is-visible {
    transform: none;
    visibility: visible;
    transition:
      transform 0.3s var(--ease),
      visibility 0s;
  }

  .sticky-cta :global(.sticky-cta__button) {
    min-height: 52px;
  }

  @media (min-width: 1100px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
