---
// 01. Hero : promesse, appel Calendly, lien vers le formulaire, réassurance.
import { getContent, type Locale } from "../../i18n";
import CalendlyLink from "../CalendlyLink.astro";
import Section from "../Section.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const h = t.hero;
---

<Section section="hero" margin={h.margin} labelledby="t-hero" class="section--hero hero">
  <h1 id="t-hero" class="hero__title">{h.title}</h1>
  <p class="hero__lead">{h.lead}</p>
  <div class="hero__actions">
    <CalendlyLink class="hero__cta" locale={locale} position="hero">{t.ui.bookCall}</CalendlyLink>
    <a class="hero__write" href={`#${t.ui.anchors.contact}`}>{h.writeLink}</a>
  </div>
  <p class="hero__note note">
    <span class="hero__note-rule" aria-hidden="true"></span>
    <span>{h.note}</span>
  </p>
</Section>

<style>
  /* La balise <section> est rendue par Section.astro : sélecteur global */
  :global(.section.hero) {
    background: radial-gradient(ellipse 90% 50% at 20% 10%, rgb(200 133 58 / 0.06) 0%, transparent 60%);
  }

  .hero__title {
    margin-bottom: 24px;
    max-width: 13ch;
    font-size: clamp(40px, 6.2vw + 22px, 92px);
    line-height: 1.04;
    letter-spacing: -0.015em;
  }

  .hero__lead {
    max-width: 600px;
    margin-bottom: 32px;
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.55;
    letter-spacing: 0;
    color: var(--ink-read);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .hero__actions :global(.hero__cta) {
    display: flex;
    width: 100%;
    min-height: 56px;
  }

  .hero__write {
    display: inline-block;
    padding: 8px 0 3px;
    border-bottom: 1px solid var(--accent);
    font-size: 14px;
    color: var(--ink-strong);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .hero__write:hover {
    color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .hero__note {
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .hero__note-rule {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 20px 32px;
      margin-top: 48px;
    }

    .hero__actions :global(.hero__cta) {
      display: inline-flex;
      width: auto;
      min-height: 58px;
    }

    .hero__lead {
      margin-bottom: 0;
    }

    .hero__note {
      display: flex;
      align-items: baseline;
      gap: 14px;
      max-width: 560px;
      margin-top: 32px;
      padding-top: 0;
      border-top: 0;
    }

    .hero__note-rule {
      display: block;
      flex: 0 0 24px;
      height: 1px;
      background: var(--accent);
      transform: translateY(-4px);
    }
  }

  @media (min-width: 1024px) {
    .hero__title {
      margin-bottom: 36px;
    }

    .hero__lead {
      font-size: 21px;
    }
  }
</style>
