---
// 09. Questions fréquentes en <details> : fonctionne sans JavaScript, au clavier, et se lit d'un trait si replié.
// name="faq" : une seule réponse ouverte à la fois (comme la maquette) ; la première est ouverte d'office.
import { getContent, type Locale } from "../../i18n";
import Section from "../Section.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const f = t.faq;
---

<Section section="faq" id={t.ui.anchors.faq} margin={f.margin} labelledby="t-faq">
  <h2 id="t-faq" class="title-section faq__title">{f.title}</h2>
  <div class="faq__list">
    {
      f.items.map((item, i) => (
        <details class="faq__item" name="faq" open={i === 0}>
          <summary class="faq__question">
            <h3 class="faq__question-text">{item.question}</h3>
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <p class="faq__answer read read--lg">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>

<style>
  .faq__title {
    margin-bottom: 24px;
  }

  .faq__list {
    max-width: 820px;
    border-top: 1px solid var(--line-visible);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-subtle);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 18px 0;
    color: var(--ink-strong);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question-text {
    font-size: 20px;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .faq__question:hover .faq__question-text {
    color: var(--accent-hover);
  }

  /* Plus quand fermé, moins quand ouvert */
  .faq__icon {
    position: relative;
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 2px;
    width: 14px;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    background: var(--accent);
    transition: transform var(--duration) ease;
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    padding: 0 0 22px;
  }

  @media (min-width: 1024px) {
    .faq__title {
      margin-bottom: 40px;
    }

    .faq__question {
      gap: 24px;
      padding: 24px 0;
    }

    .faq__question-text {
      font-size: 23px;
    }

    .faq__answer {
      padding: 0 48px 28px 0;
    }
  }
</style>
