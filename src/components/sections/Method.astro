---
// 04. Méthode : cinq étapes numérotées ; l'étape « L'humain garde la décision » porte la signature.
import { getContent, type Locale } from "../../i18n";
import Section from "../Section.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const m = t.method;
---

<Section section="method" id={t.ui.anchors.method} margin={m.margin} labelledby="t-method" band>
  <h2 id="t-method" class="title-section method__title">{m.title}</h2>
  <ol class="method__list">
    {
      m.steps.map((step, i) => (
        <li class:list={["method__step", { "method__step--signed": i === m.signatureStep }]}>
          <span class="method__number" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div>
            <h3 class="method__step-title">{step.title}</h3>
            <p class="read read--lg">{step.text}</p>
          </div>
          {i === m.signatureStep && <p class="method__signature signature">{t.ui.signature}</p>}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .method__title {
    margin-bottom: 28px;
  }

  .method__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line-visible);
  }

  .method__step {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 14px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-subtle);
  }

  .method__step--signed {
    background: linear-gradient(90deg, rgb(200 133 58 / 0.07), transparent 80%);
  }

  .method__number {
    font-size: 18px;
    line-height: 1.4;
    color: var(--accent);
  }

  .method__step-title {
    margin-bottom: 6px;
    font-size: 21px;
    line-height: 1.25;
  }

  .method__signature {
    grid-column: 2;
    margin-top: 12px;
    font-size: 19px;
  }

  @media (min-width: 1024px) {
    .method__title {
      margin-bottom: 48px;
    }

    .method__step {
      grid-template-columns: 72px minmax(0, 1fr) minmax(0, 220px);
      column-gap: 32px;
      padding: 30px 0;
    }

    .method__step--signed {
      background: linear-gradient(90deg, rgb(200 133 58 / 0.06), transparent 70%);
    }

    .method__number {
      font-size: 26px;
      line-height: 1.2;
    }

    .method__step-title {
      margin-bottom: 8px;
      font-size: 25px;
    }

    .method__step .read {
      max-width: 580px;
    }

    .method__signature {
      grid-column: 3;
      align-self: center;
      margin: 0;
      font-size: 21px;
      line-height: 1.3;
    }
  }
</style>
