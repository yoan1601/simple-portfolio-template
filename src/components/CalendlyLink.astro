---
// Bouton plein vers Calendly (seul bouton plein de la page), événement premier-echange.
// UTM : source = le site, campagne = la langue de la page, contenu = la position du bouton,
// pour savoir dans Calendly d'où vient chaque réservation. Clic suivi par Umami (calendly_click).
import { links, type Locale } from "../i18n";

export type CalendlyPosition = "header" | "menu" | "hero" | "offer" | "contact" | "sticky";

interface Props {
  locale: Locale;
  position: CalendlyPosition;
  size?: "sm" | "lg" | "block";
  arrow?: boolean;
  class?: string;
}

const { locale, position, size = "lg", arrow = true, class: className } = Astro.props;

const url = new URL(links.calendly);
url.searchParams.set("utm_source", "harena.systems");
url.searchParams.set("utm_medium", "site");
url.searchParams.set("utm_campaign", `landing-${locale}`);
url.searchParams.set("utm_content", position);
---

<a
  class:list={["btn", "btn--primary", `btn--${size}`, className]}
  href={url.href}
  target="_blank"
  rel="noopener"
  data-umami-event="calendly_click"
  data-umami-event-position={position}
  data-umami-event-locale={locale}
>
  <slot />
  {
    arrow && (
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7" />
        <path d="M8 7h9v9" />
      </svg>
    )
  }
</a>

{/* UTM d'arrivée (ex. utm_source=lahety) reportés sur ces liens : script inclus une seule fois par page */}
<script>
  import { initUtmPassThrough } from "../scripts/utm";
  initUtmPassThrough();
</script>
