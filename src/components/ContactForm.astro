---
// Formulaire Web3Forms, en second derrière Calendly.
// Sans JavaScript : envoi classique vers Web3Forms (page de confirmation de Web3Forms).
// Avec JavaScript (src/scripts/form.ts) : envoi en arrière-plan, états dans la page :
//   envoi en cours (bouton désactivé), succès en ambre (role="status"), erreur en #E5705A (role="alert"),
//   message conservé en cas d'erreur, form_submit envoyé à Umami seulement si Web3Forms confirme.
// Clé publique lue au build depuis astro:env (.env en local, variables Vercel en ligne).
import { PUBLIC_WEB3FORMS_ACCESS_KEY } from "astro:env/client";
import { getContent, links, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const f = getContent(locale).contact.form;
---

<div class="contact-form" data-contact-form data-locale={locale}>
  <form
    class="contact-form__form"
    action="https://api.web3forms.com/submit"
    method="POST"
    aria-label={f.label}
    data-form
  >
    <input type="hidden" name="access_key" value={PUBLIC_WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value={f.emailSubject} />
    <input type="hidden" name="from_name" value="harena.systems" />
    {/* Piège à robots de Web3Forms : invisible, jamais coché par un humain */}
    <input type="checkbox" name="botcheck" class="contact-form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="contact-form__row">
      <div class="contact-form__field">
        <label for={`f-name-${locale}`}>{f.fields.name}</label>
        <input id={`f-name-${locale}`} type="text" name="name" autocomplete="name" required />
      </div>
      <div class="contact-form__field">
        <label for={`f-email-${locale}`}>{f.fields.email}</label>
        <input id={`f-email-${locale}`} type="email" name="email" autocomplete="email" required />
      </div>
    </div>
    <div class="contact-form__field">
      <label for={`f-message-${locale}`}>{f.fields.message}</label>
      <textarea id={`f-message-${locale}`} name="message" rows="5" required></textarea>
    </div>

    {/* Erreur : zone présente dès le chargement pour être annoncée par les lecteurs d'écran */}
    <div class="contact-form__error" role="alert" data-form-error></div>

    <div class="contact-form__actions">
      <button class="btn btn--ghost contact-form__submit" type="submit" data-form-submit>
        <span class="contact-form__spinner" aria-hidden="true"></span>
        <span data-form-submit-label>{f.submit}</span>
      </button>
    </div>
  </form>

  {/* Succès : zone vide au chargement, remplie après confirmation de Web3Forms */}
  <div class="contact-form__status" role="status" data-form-status></div>

  {/* Gabarits clonés par form.ts */}
  <template data-form-template-success>
    <div class="contact-form__success">
      <span class="contact-form__success-badge">{f.successBadge}</span>
      <div class="contact-form__success-body">
        <span class="contact-form__success-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5"></path>
          </svg>
        </span>
        <p class="contact-form__success-text">{f.success}</p>
      </div>
    </div>
  </template>
  <template data-form-template-error>
    <svg class="contact-form__error-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7.5v5.5"></path>
      <path d="M12 16.5v.01"></path>
    </svg>
    <p>
      {f.error.text}{" "}<a href={links.linkedin} target="_blank" rel="noopener" data-umami-event="linkedin_click" data-umami-event-position="form-error">{f.error.link}</a>{f.error.end}
    </p>
  </template>
  <span hidden data-form-sending-label>{f.sending}</span>
</div>

<script>
  import { initContactForms } from "../scripts/form";
  initContactForms();
</script>

<style>
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .contact-form__trap {
    display: none;
  }

  .contact-form__row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px 24px;
  }

  .contact-form__row .contact-form__field {
    flex: 1 1 200px;
    min-width: 0;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-form__field label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-secondary);
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 4px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-offer);
    border-radius: 0;
    color: var(--ink-title);
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.5;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .contact-form__field textarea {
    min-height: 140px;
    resize: vertical;
  }

  /* Focus (planche du formulaire) : filet bas ambre et fond teinté, sans cadre */
  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-bottom-color: var(--accent);
    background: rgb(200 133 58 / 0.04);
  }

  .contact-form__actions {
    margin-top: 6px;
  }

  .contact-form__spinner {
    display: none;
    width: 12px;
    height: 12px;
    border: 2px solid rgb(200 133 58 / 0.3);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: contact-form-spin 0.8s linear infinite;
  }

  /* Envoi en cours */
  .contact-form__submit[aria-busy="true"] {
    background: rgb(200 133 58 / 0.1);
    border-color: rgb(200 133 58 / 0.5);
    color: var(--ink-secondary);
    cursor: progress;
  }

  .contact-form__submit[aria-busy="true"] .contact-form__spinner {
    display: inline-block;
  }

  @keyframes contact-form-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Erreur : rouge chaud #E5705A, message du visiteur conservé dans les champs */
  .contact-form__error:empty {
    display: none;
  }

  .contact-form__error {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid var(--error);
    border-radius: var(--radius);
    background: var(--error-veil);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-title);
  }

  .contact-form__error :global(.contact-form__error-icon) {
    flex: 0 0 18px;
    margin-top: 3px;
    color: var(--error);
  }

  .contact-form__error :global(a) {
    color: var(--ink-strong);
    text-decoration: underline;
    text-decoration-color: var(--error);
    text-underline-offset: 3px;
  }

  /* Succès : ambre */
  .contact-form__status:empty {
    display: none;
  }

  .contact-form__status :global(.contact-form__success) {
    position: relative;
    padding: 36px 22px 30px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgb(200 133 58 / 0.04);
  }

  .contact-form__status :global(.contact-form__success-badge) {
    position: absolute;
    top: -10px;
    left: 18px;
    padding: 0 10px;
    background: var(--bg);
    font-size: 11px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .contact-form__status :global(.contact-form__success-body) {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .contact-form__status :global(.contact-form__success-icon) {
    display: flex;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
  }

  .contact-form__status :global(.contact-form__success-text) {
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .contact-form__status :global(.contact-form__success) {
      padding: 40px 32px 36px;
    }

    .contact-form__status :global(.contact-form__success-badge) {
      left: 24px;
    }

    .contact-form__status :global(.contact-form__success-body) {
      gap: 18px;
    }

    .contact-form__status :global(.contact-form__success-text) {
      font-size: 25px;
    }
  }
</style>
