---
// Coquille HTML commune : langue, métadonnées, Open Graph, hreflang, polices, Umami. Aucune mise en page ici.
import { Font } from "astro:assets";
import { PUBLIC_UMAMI_WEBSITE_ID } from "astro:env/client";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getContent, locales, type Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const canonical = getAbsoluteLocaleUrl(locale);
const otherLocales = locales.filter((l) => l !== locale);
// Images de partage 1200 × 630 : ajoutées à l'étape 9.
const ogImage = new URL(`/og/og-${locale}.png`, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("fr")} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0A0A08" />

    <!-- Open Graph et carte de partage, par langue -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.ui.siteName} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={getContent(l).meta.ogLocale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Polices auto-hébergées ; seul le titre du hero (DM Serif droit) est préchargé -->
    <Font cssVariable="--font-display" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    <!-- Umami : ne compte que sur les domaines de production (aperçus et local ignorés).
         Visites de Harena exclues par localStorage.setItem("umami.disabled", "1") dans son navigateur. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id={PUBLIC_UMAMI_WEBSITE_ID}
      data-domains="harena.systems,www.harena.systems"></script>
  </head>
  <body>
    <a class="skip-link" href={`#${t.ui.anchors.top}`}>{t.ui.skipLink}</a>
    <slot />
  </body>
</html>
