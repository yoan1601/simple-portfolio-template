---
// Coquille HTML commune : langue, métadonnées, hreflang. Aucune mise en page ici.
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getContent, locales, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("fr")} />
  </head>
  <body>
    <slot />
  </body>
</html>
